// Funny Idioms Video Factory - V1 schema
//
// Portability note (SQLite -> PostgreSQL):
//  * No Prisma `enum` blocks: SQLite does not support them. Enum-like columns are
//    `String` and validated in TypeScript via src/domain/enums.ts + Zod.
//  * No `Json` scalar: SQLite does not support it. JSON payloads live in `String`
//    columns suffixed `Json` and are parsed through Zod at the edges.
//  * No binary blobs: media lives on disk, the DB only stores relative paths.
//  Migrating to Postgres = change the datasource provider and (optionally) swap
//  the String enum columns for native enums. No application code has to move.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- content ---

model Idiom {
  id              String    @id @default(uuid())
  phrase          String
  slug            String    @unique
  meaning         String
  literalMeaning  String
  exampleSentence String
  category        String
  difficulty      String    @default("Beginner")
  region          String    @default("General")
  notes           String    @default("")
  status          String    @default("unused")
  timesUsed       Int       @default(0)
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  projects Project[]

  @@index([status])
  @@index([category])
  @@index([difficulty])
}

/// The canonical identity of a recurring character.
///
/// Character consistency is the single hardest problem in this niche: an AI that
/// redraws Max with different hair in scene 3 makes the video look broken no
/// matter how good each frame is. Everything here exists to be pasted verbatim
/// into every prompt rather than re-invented per scene.
model Character {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String
  personality     String

  // ---- canonical appearance: copied into every prompt, never regenerated ----
  visualPrompt    String
  negativePrompt  String   @default("")
  /// Face shape, eyes, nose, expression tendencies.
  facialFeatures  String   @default("")
  /// Colour, length, style. The most commonly drifted attribute.
  hair            String   @default("")
  /// Everyday clothing. Changes only when a scene explicitly calls for it.
  outfit          String   @default("")
  /// Height relative to the other characters, build, head-to-body ratio.
  bodyProportions String   @default("")
  accessories     String   @default("")
  /// Dominant colours, so a scene cannot silently recolour the character.
  colorPalette    String   @default("")

  /// Bumped whenever the canonical description changes, so images generated
  /// against an older description can be told apart from current ones.
  version         Int      @default(1)

  /// Style preset this character was designed for. Null = project default.
  stylePresetId   String?

  // ---- voice: every field editable in the UI, none hard-coded in code ----
  /// Which vendor speaks for this character. Changing it must not need a deploy.
  voiceProvider   String   @default("mock")
  voiceModel      String   @default("mock-voice-std")
  /// Vendor's voice id. Deliberately a free string: each vendor names its own.
  voiceId         String   @default("mock-male-us")
  /// Delivery direction, the part that makes a TTS voice act rather than read.
  /// gpt-4o-mini-tts takes this verbatim; vendors without it ignore it.
  voiceInstructions String @default("")
  /// 0.25-4.0 where the vendor supports it. 1 = the voice's natural pace.
  voiceSpeed      Float    @default(1)
  voiceGender     String   @default("male")
  voiceAccent     String   @default("US")
  seed            Int?
  notes           String   @default("")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  references CharacterReference[]
  dialogueLines DialogueLine[]

  @@index([enabled])
}

/// One spoken line, by one character, in one scene.
///
/// Voice used to be one file per scene, spoken by whoever happened to be first
/// in the speaking list. That cannot represent the ordinary case of two
/// characters trading lines in the same beat, and it silently dropped the
/// second speaker's audio.
///
/// A row per line also makes each line's cost, voice and settings answerable
/// individually - which matters because a line is the unit that gets
/// regenerated when the delivery is wrong.
model DialogueLine {
  id           String   @id @default(uuid())
  sceneId      String
  characterId  String?
  /// Order within the scene. Two lines never share one.
  lineNumber   Int
  text         String

  // ---- resolved at generation time, kept so a result can be explained ----
  provider     String   @default("")
  model        String   @default("")
  voiceId      String   @default("")
  instructions String   @default("")
  speed        Float    @default(1)

  /// Silence after this line, in milliseconds. Null = use the default, which
  /// is 150ms between lines by one speaker and 280ms at a change of speaker.
  ///
  /// Stored per LINE rather than per scene so a script can hold a beat before a
  /// punchline without slowing every other exchange in the same scene.
  pauseAfterMs  Int?

  estimatedCost Float   @default(0)
  actualCost    Float   @default(0)
  /// Measured from the rendered file, not promised by the provider.
  durationSec   Float   @default(0)
  /// Relative path under data/. SQLite stores the path, never the audio.
  outputPath   String   @default("")
  status       String   @default("pending")
  error        String   @default("")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scene     Scene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([sceneId, lineNumber])
  @@index([sceneId])
  @@index([characterId])
  @@index([status])
}

/// One reference image for a character.
///
/// Stored as rows rather than a JSON array so a single image can be promoted,
/// approved, or deleted without rewriting the whole set, and so the approved
/// master is a queryable fact rather than a convention.
model CharacterReference {
  id          String   @id @default(uuid())
  characterId String
  /// Path relative to the data root. The file itself never lives in SQLite.
  filePath    String
  /// "upload" when a human supplied it, "generated" when an AI did.
  source      String   @default("upload")
  /// Exactly one primary per character: the master image prompts refer to.
  isPrimary   Boolean  @default(false)
  /// A generated master must be approved by a human before it becomes primary.
  approved    Boolean  @default(false)
  provider    String   @default("")
  model       String   @default("")
  prompt      String   @default("")
  /// Character version this image was generated against.
  characterVersion Int @default(1)
  width       Int      @default(0)
  height      Int      @default(0)
  bytes       Int      @default(0)
  notes       String   @default("")
  createdAt   DateTime @default(now())

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, isPrimary])
}

model StylePreset {
  id              String   @id @default(uuid())
  name            String   @unique
  slug            String   @unique
  positivePrompt  String
  negativePrompt  String
  lightingStyle   String
  cameraLanguage  String
  visualTone      String
  aspectRatio     String   @default("9:16")
  preferredModels String   @default("[]")
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  projects Project[]
}

// --------------------------------------------------------------- registry ---

model ModelRegistry {
  id                         String   @id @default(uuid())
  provider                   String
  modelId                    String
  displayName                String
  type                       String
  enabled                    Boolean  @default(true)
  priceUnit                  String
  price                      Float    @default(0)
  // Text APIs bill input and output tokens at different rates, so a single
  // price field cannot express them. Ignored (left 0) for every other type.
  priceOutput                Float    @default(0)
  supportsTextToVideo        Boolean  @default(false)
  supportsImageToVideo       Boolean  @default(false)
  supportsReferenceImage     Boolean  @default(false)
  supportsCharacterReference Boolean  @default(false)
  // Some image models accept an "input_fidelity" hint that asks them to
  // preserve faces and clothing from the reference images; others reject the
  // parameter outright with a 400. Which is which is the vendor's business and
  // changes per model, so it is data here rather than a table in code.
  supportsInputFidelity      Boolean  @default(false)
  supportsAudio              Boolean  @default(false)
  supports1080p              Boolean  @default(false)
  supportsUpscale            Boolean  @default(false)
  /// Voice models that take a free-text delivery direction (gpt-4o-mini-tts).
  /// Without it, a voice reads the line; with it, the voice acts it.
  supportsVoiceInstructions Boolean @default(false)
  maxDuration                Int      @default(0)
  qualityRating              Int      @default(5)
  speedRating                Int      @default(5)
  consistencyRating          Int      @default(5)
  historicalSuccessRate      Float    @default(1)
  /// When a human last checked this row against the vendor's own pricing and
  /// model list. Null means never verified - treat the price as a guess.
  lastVerifiedAt             DateTime?
  notes                      String   @default("")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([provider, modelId])
  @@index([type, enabled])
}

model ProviderConfig {
  id               String    @id @default(uuid())
  name             String    @unique
  displayName      String
  types            String    @default("[]")
  enabled          Boolean   @default(true)
  apiKeyEnc        String?
  apiKeyMask       String?
  apiKeyEnvVar     String    @default("")
  baseUrl          String    @default("")
  priority         Int       @default(100)
  fallbackPriority Int       @default(100)
  status           String    @default("disabled")
  lastCheckedAt    DateTime?
  notes            String    @default("")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// --------------------------------------------------------------- projects ---

model Project {
  id              String   @id @default(uuid())
  idiomId         String
  batchId         String?
  title           String
  status          String   @default("draft")
  qualityMode     String   @default("BALANCED")
  routerStrategy  String   @default("AUTO")
  stylePresetId   String?
  targetDuration  Int      @default(25)
  aspectRatio     String   @default("9:16")
  language        String   @default("en")
  scriptJson      String?
  scriptHash      String?
  angleKey        String?
  scriptScoreJson String?
  youtubeMetaJson String?
  estimatedCost   Float    @default(0)
  actualCost      Float    @default(0)
  maxBudget       Float    @default(10)
  finalVideoPath  String?
  subtitlePath    String?
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  idiom       Idiom        @relation(fields: [idiomId], references: [id])
  stylePreset StylePreset? @relation(fields: [stylePresetId], references: [id])
  batch       Batch?       @relation(fields: [batchId], references: [id])
  scenes      Scene[]
  assets      Asset[]
  costs       CostEntry[]
  jobs        Job[]

  @@index([status])
  @@index([createdAt])
  @@index([batchId])
}

model Scene {
  id                String   @id @default(uuid())
  projectId         String
  sceneNumber       Int
  duration          Float    @default(4)
  visualDescription String   @default("")
  dialogue          String   @default("")
  narration         String   @default("")
  subtitle          String   @default("")
  camera            String   @default("")
  characterAction   String   @default("")
  soundEffect       String   @default("")
  imagePrompt       String   @default("")
  videoPrompt       String   @default("")
  complexity        String   @default("LOW")
  spendPriority     String   @default("NORMAL")
  /// Everyone VISIBLE in the frame, whether they speak or not.
  ///
  /// This is the list that drives image generation. It exists separately from
  /// the speaking list because a character who reacts in the background still
  /// has to be drawn on-model, and deriving presence from dialogue silently
  /// dropped exactly those characters.
  charactersPresentJson   String   @default("[]")
  /// Only those with a spoken line. Drives voice generation, not images.
  speakingCharactersJson  String   @default("[]")
  /// The focus of the shot. First in line for a reference image when the
  /// provider limits how many can be sent.
  primaryCharactersJson   String   @default("[]")
  routingMode       String   @default("AUTO")
  imageProvider     String?
  imageModel        String?
  videoProvider     String?
  videoModel        String?
  voiceProvider     String?
  voiceModel        String?
  estimatedCost     Float    @default(0)
  actualCost        Float    @default(0)
  imagePath         String?
  videoPath         String?
  audioPath         String?
  qualityScore      Float?
  qualityJson       String?
  retryCount        Int      @default(0)
  status            String   @default("pending")
  approved          Boolean  @default(false)
  skipped           Boolean  @default(false)
  /// Markers a provider earned on this scene, as a JSON array of strings.
  ///
  /// RUNWAY_UNSUITABLE is written when Runway answers INTERNAL.BAD_OUTPUT: the
  /// model is saying it cannot make something acceptable from this input, and
  /// that does not change on a retry. The router then stops offering Runway
  /// this scene instead of paying to learn the same thing again.
  providerFlagsJson String   @default("[]")

  errorMessage      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets  Asset[]
  dialogueLines DialogueLine[]

  @@unique([projectId, sceneNumber])
  @@index([status])
}

model Asset {
  id               String   @id @default(uuid())
  projectId        String
  sceneId          String?
  kind             String
  provider         String
  model            String
  prompt           String   @default("")
  negativePrompt   String   @default("")
  seed             Int?
  status           String   @default("completed")
  generationTimeMs Int      @default(0)
  estimatedCost    Float    @default(0)
  actualCost       Float    @default(0)
  filePath         String
  bytes            Int      @default(0)
  createdAt        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene   Scene?  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([projectId, kind])
}

// ------------------------------------------------------------------- jobs ---

model Batch {
  id             String   @id @default(uuid())
  name           String
  amount         Int      @default(5)
  category       String?
  difficulty     String?
  stylePresetId  String?
  qualityMode    String   @default("BALANCED")
  targetDuration Int      @default(25)
  voiceProvider  String   @default("mock")
  voiceId        String   @default("mock-male-us")
  maxBudget      Float    @default(40)
  concurrency    Int      @default(2)
  status         String   @default("queued")
  estimatedCost  Float    @default(0)
  actualCost     Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projects Project[]
  jobs     Job[]
}

model Job {
  id          String    @id @default(uuid())
  type        String
  payloadJson String    @default("{}")
  status      String    @default("queued")
  priority    Int       @default(100)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  nextRunAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  error       String?
  resultJson  String?
  projectId   String?
  batchId     String?
  sceneId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  batch   Batch?   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([projectId])
}

// A record of every request handed to an external provider. This is what keeps us
// from paying twice for one scene: before any retry or fallback we look for a live
// ProviderJob and resume it instead of submitting a new paid generation.
model ProviderJob {
  id             String    @id @default(uuid())
  provider       String
  model          String
  kind           String
  /// Task ids from earlier attempts on this same idempotency key, newest last.
  ///
  /// Runway has NO endpoint that lists tasks: a task id can only be looked up
  /// if it was written down. Overwriting `externalId` on a retry therefore lost
  /// the previous task forever, and with it any chance of finding out whether
  /// it had been billed.
  previousExternalIds String @default("[]")

  externalId     String?
  idempotencyKey String    @unique
  status         String    @default("pending")
  requestJson    String    @default("{}")
  responseJson   String?
  error          String?
  projectId      String?
  sceneId        String?
  attempts       Int       @default(0)
  // Reported by the provider. Null when the API returns no usage figures.
  inputTokens    Int?
  outputTokens   Int?
  durationMs     Int?
  estimatedCost  Float     @default(0)
  actualCost     Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  @@index([status])
  @@index([sceneId, kind])
}

// -------------------------------------------------------- cost + telemetry ---

// The accounting ledger. Note the relation below is SetNull, not Cascade:
// deleting a project must NOT erase money that was really spent. Cascading here
// would quietly refund the spend cap and let it be exceeded.
model CostEntry {
  id        String   @id @default(uuid())
  projectId String?
  batchId   String?
  sceneId   String?
  category  String
  provider  String
  model     String
  amount    Float
  estimated Boolean  @default(false)
  isRetry   Boolean  @default(false)
  note      String   @default("")
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([category])
}

model LogEntry {
  id            String   @id @default(uuid())
  level         String   @default("info")
  event         String
  message       String   @default("")
  provider      String?
  model         String?
  projectId     String?
  sceneId       String?
  jobId         String?
  durationMs    Int?
  estimatedCost Float?
  actualCost    Float?
  status        String?
  dataJson      String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([level])
}

// Duplicate prevention: one row per generated concept.
model ConceptHistory {
  id         String   @id @default(uuid())
  idiomId    String
  projectId  String?
  angleKey   String
  scriptHash String
  summary    String   @default("")
  createdAt  DateTime @default(now())

  @@index([idiomId])
  @@index([scriptHash])
}

/// One real, paid benchmark run: what was sent, what came back, what it scored.
///
/// This is the evidence the routing rules are derived FROM, kept so the rules
/// can be checked against it. Every limit in domain/video-suitability was
/// inferred from runs like these, and an inferred rule that contradicts the run
/// it came from is a bug - one that already happened twice, and both times was
/// caught by a person remembering rather than by anything in the code.
model VideoBenchmark {
  id            String   @id @default(uuid())

  provider      String
  model         String
  /// Vendor-side task id, so the run can still be looked up at the provider.
  taskId        String?

  projectId     String?
  sceneNumber   Int
  /// Complexity as the classifier scored it AT THE TIME of the run.
  complexity    String
  complexityScore Float  @default(0)
  characterCount  Int    @default(0)

  /// The prompt actually sent, after any vendor-specific fitting.
  promptSent    String   @default("")
  durationRequested Float @default(0)
  /// Seconds the vendor actually billed. Differs from requested for Runway.
  durationSent  Float    @default(0)
  keyframePath  String   @default("")

  outcome       String
  /// Vendor failure code when it failed, e.g. INTERNAL.BAD_OUTPUT.CODE01.
  failureCode   String   @default("")
  credits       Int      @default(0)
  actualCost    Float    @default(0)
  generationMs  Int      @default(0)
  outputPath    String   @default("")

  /// Human scores, 1-10, as JSON. Null for a run that produced nothing to score.
  scoresJson    String   @default("{}")
  /// What went wrong, in the reviewer's words.
  notes         String   @default("")

  createdAt     DateTime @default(now())

  @@index([provider, model])
  @@index([sceneNumber])
  @@index([outcome])
}

model Setting {
  key       String   @id
  valueJson String
  updatedAt DateTime @updatedAt
}
