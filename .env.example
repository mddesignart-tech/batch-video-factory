# ---------------------------------------------------------------------------
# Funny Idioms Video Factory - environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Local SQLite database. Path is relative to the `prisma/` folder.
DATABASE_URL="file:../data/app.db"

# MOCK MODE ------------------------------------------------------------------
# true  = no paid API is ever called. Fake provider jobs, fake delays, locally
#         generated placeholder media. The whole pipeline still runs end to end
#         and FFmpeg still produces a real MP4. This is the Milestone 1 default.
# false = real providers are used for any provider that has a key configured.
AI_MOCK_MODE=true

# Encryption key for API keys saved through the admin UI (AES-256-GCM).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the admin UI refuses to store keys and only env vars are used.
SECRET_ENCRYPTION_KEY=

# JOB QUEUE ------------------------------------------------------------------
# Keep this low. It is the throttle that stops a runaway batch from firing a
# hundred paid generations at once.
JOB_CONCURRENCY=2
JOB_WORKER_ENABLED=true

# FFMPEG ---------------------------------------------------------------------
# Leave blank to use the bundled ffmpeg-static binary, or point at your own
# install, e.g. FFMPEG_PATH="C:\\ffmpeg\\bin\\ffmpeg.exe"
FFMPEG_PATH=
FFPROBE_PATH=

# SPEND CAP ------------------------------------------------------------------
# Hard ceiling on REAL provider spending for the whole application, in USD.
# Checked immediately before every paid request, counting actual recorded spend
# across every project and retry. Editable in the Settings page.
# Default is 0.50 - deliberately low.
#
# This is separate from a project MAX BUDGET: that caps one video, this caps
# everything the app is ever allowed to spend.

# PROVIDER KEYS (all optional - absent key simply means that provider is
# reported as "Missing API key" and is skipped by the router) -----------------

# --- text (integrated, Milestone 2 step 1) ---
# All of these speak the OpenAI Chat Completions dialect.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
# Ollama / LM Studio run locally: no key needed, and they cost nothing. The
# cheapest honest way to test real Text AI. See docs/PROVIDERS.md.

# --- not yet integrated (later milestones) ---
TEXT_AI_API_KEY=
GOOGLE_AI_API_KEY=
RUNWAY_API_KEY=
KLING_API_KEY=
VOICE_API_KEY=
ELEVENLABS_API_KEY=

# CLEANUP RETENTION (days) ---------------------------------------------------
CLEANUP_TEMP_DAYS=3
CLEANUP_FAILED_DAYS=7
# Final exports are kept forever unless this is explicitly set to a number.
CLEANUP_FINAL_DAYS=
