# dependencies
node_modules/

# next
.next/
out/
next-env.d.ts

# env - NEVER commit real keys
.env
.env.local
.env.*.local

# local data: SQLite database, generated media, backups.
# Anchored with a leading slash so these match only at the repo root - a bare
# "data/" would also swallow src/data/, which is source code.
/data/
/backups/
*.db
*.db-journal
*.db-wal
*.db-shm

# generated media / temp
*.mp4
*.mov
*.wav
*.mp3
*.srt
*.ass
!public/**/*.mp4

# tooling
.DS_Store
Thumbs.db
*.tsbuildinfo
coverage/
.vitest/

# Throwaway world for the import end-to-end mock run (scripts/import-e2e-mock.ts)
data/.import-e2e/
data/.real-import/
